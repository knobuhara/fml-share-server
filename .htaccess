<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Only rewrite API requests (remove .php extension)
    RewriteBase /app/
    
    # Existing files and directories pass through
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Only rewrite /api/* paths to .php
    RewriteRule ^api/(.*)$ api/$1.php [NC,L]
</IfModule>
