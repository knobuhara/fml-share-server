# Database Configuration for Local Development (with PuTTY SSH tunnel)
# To use: Start PuTTY SSH tunnel first (see .env.xserver for setup instructions)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=bears_fmlshare
DB_USER=bears_admin
DB_PASSWORD=__YOUR_LOCAL_DB_PASSWORD__

# JWT Configuration
JWT_SECRET=__YOUR_LOCAL_JWT_SECRET__

# Xserver FTP Configuration
XSERVER_HOST=__YOUR_XSERVER_HOST__
XSERVER_PORT=21
XSERVER_USERNAME=__YOUR_XSERVER_USERNAME__
XSERVER_PASSWORD=__YOUR_XSERVER_PASSWORD__
XSERVER_VIDEO_PATH=/public_html/nobu_contents
XSERVER_VIDEO_BASE_URL=https://webftp-sv161.xserver.jp/public_html/nobu_contents

# CORS Settings
CORS_ORIGINS=https://bears.xsrv.jp,http://localhost:8080,http://localhost:3000

# API Settings
API_PORT=3001
API_ENV=development
API_DEBUG=true

# File Upload Settings
MAX_FILE_SIZE=5368709120
ALLOWED_EXTENSIONS=mp4,mkv,avi,mov,flv,wmv,webm

# Session Settings
SESSION_LIFETIME=86400
JWT_EXPIRY=86400
