# Database Configuration for Xserver Production
# Note: All sensitive values will be overridden by GitHub Secrets during CI/CD deployment
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bears_fmlshare
DB_USER=bears_admin
DB_PASSWORD=__REPLACED_BY_GITHUB_SECRETS__

# JWT Configuration
# Note: This value will be overridden by GitHub Secrets during CI/CD deployment
JWT_SECRET=__REPLACED_BY_GITHUB_SECRETS__

# Xserver FTP Configuration
# Note: HOST, USERNAME, PASSWORD will be overridden by GitHub Secrets during CI/CD deployment
XSERVER_HOST=__REPLACED_BY_GITHUB_SECRETS__
XSERVER_PORT=21
XSERVER_USERNAME=__REPLACED_BY_GITHUB_SECRETS__
XSERVER_PASSWORD=__REPLACED_BY_GITHUB_SECRETS__
XSERVER_VIDEO_PATH=/public_html/nobu_contents
XSERVER_VIDEO_BASE_URL=https://webftp-sv161.xserver.jp/public_html/nobu_contents

# CORS Settings
CORS_ORIGINS=https://bears.xsrv.jp,http://localhost:8080,http://localhost:3000

# API Settings
API_PORT=3001
API_ENV=production
API_DEBUG=false

# File Upload Settings
MAX_FILE_SIZE=5368709120
ALLOWED_EXTENSIONS=mp4,mkv,avi,mov,flv,wmv,webm

# Session Settings
SESSION_LIFETIME=86400
JWT_EXPIRY=86400
